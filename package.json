{
  "name": "guideo",
  "version": "0.1.0",
  "private": true,
  "description": "Guideo generates walkthrough demo videos of a web target from a single URL and credentials.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "guideo": "bin/guideo.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:physical-render": "npm run test:physical-render:matrix",
    "lint": "biome check .",
    "guideo": "node --env-file-if-exists=.env --import tsx src/app/cli.ts",
    "test:physical-render:matrix": "vitest run tests/app/validation/physical-render-validator.integration.test.ts",
    "lint:physical-render": "biome check src/app/validation/physical-render-matrix.ts src/app/validation/physical-render-validator.ts tests/app/validation/physical-render-matrix.test.ts tests/app/validation/physical-render-validator.integration.test.ts",
    "benchmark:ci": "node scripts/benchmark-ci.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "@elevenlabs/elevenlabs-js": "2.59.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "^3.1.0",
    "patchright": "1.61.1",
    "zod": "4.4.3"
  }
}

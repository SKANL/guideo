# Guideo — environment variables
# Copy to `.env` and fill in. Loaded via Node's native `node --env-file=.env`.
# Never commit the real `.env` (it is git-ignored).

# --- Voice (ElevenLabs, free tier) ---
ELEVENLABS_API_KEY=

# --- Target platform to record (URL + creds branch) ---
GUIDEO_TARGET_URL=
GUIDEO_TARGET_USERNAME=
GUIDEO_TARGET_PASSWORD=

# --- Optional: override the bundled ffmpeg binary path ---
# GUIDEO_FFMPEG_PATH=

# --- AI (Claude Agent SDK / Codex SDK) ---
# Runs on the user's MAX subscription via the logged-in CLI session.
# No paid API key is set here by design. If the SDK ever needs an explicit
# token in your environment, document it, do not hardcode it.
